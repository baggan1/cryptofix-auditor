    "scoring_model": "two-level: message-type presence + essential tag coverage",
    "fix_reference_primary": "https://fiximate.fixtrading.org/",
    "tier_structure_note": "Tier 1 covers order lifecycle messages. Tier 2 covers execution quality tags within 35=8. Tier 3 covers post-trade and RFQ messages. Session reliability removed from Tier 3. Tier 4 tags evaluated in context of 35=8 or 35=AE.",
    "scoring_guide": {
      "90-100": "Institutional grade",
      "70-89": "Near-institutional",
      "50-69": "Partial",
      "30-49": "Basic",
      "0-29": "Pre-institutional"
    }
  },
  "scoring": {
    "tier_weights": {
      "tier1_order_lifecycle": 40,
      "tier2_execution_quality_tca": 25,
      "tier3_post_trade_allocation": 25,
      "tier4_aml_travel_rule": 10,
      "tier5_dawg_extensions": 0
    }
  },
  "ai_extraction_prompt": {
    "role": "system",
    "content": "You are a FIX protocol specialist with deep knowledge of institutional trading. Analyze the provided exchange FIX specification and score each check_id in the rubric using a TWO-LEVEL model:\n\nFor message-level checks (check_id ends in _000):\n  full_credit   = message type is explicitly documented with a tag table\n  partial_credit = message is mentioned but documentation is incomplete\n  no_credit     = message is absent\n\nFor tag-level checks (check_id contains a tag number):\n  full_credit   = tag explicitly listed in that specific message type's table\n  partial_credit = tag present but conditional, restricted, or via custom tag\n  no_credit     = tag absent from that message type's documentation\n\nIMPORTANT: Score each tag WITHIN its message type context. Tag 55 (Symbol) may be present in 35=D but not 35=F — score each separately. Do not assume a tag present in one message is present in another."
  },
